# El código interno no debe ser accesible desde el navegador.
RedirectMatch 404 ^/.*/includes/.*$

# Ni el esquema de la base de datos, ni documentación/notas internas,
# ni archivos comprimidos sueltos: nada de esto debe poder descargarse.
RedirectMatch 404 ^/.*/sql/.*$
RedirectMatch 404 ^/.*/herramientas/.*$
<FilesMatch "\.(sql|md|rar|zip|ps1|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeceras de seguridad básicas.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# No listar el contenido de las carpetas.
Options -Indexes
